# Postgres (Neon / Supabase / Vercel Postgres). Must enable pgvector.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

OPENAI_API_KEY="sk-..."
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_ROUTING_MODEL="gpt-4o-mini"

# Similarity thresholds (optional)
SIMILARITY_THRESHOLD="0.37"
UNMET_MERGE_SIMILARITY="0.88"

DEVELOPER_JWT_SECRET="change-me-to-at-least-16-chars-long"
DEVELOPER_PASSWORD="change-me-plaintext-mvp"
# Prefer bcrypt hashes in prod:
# npx bcryptjs-hash "yourpassword"
# DEVELOPER_PASSWORD_BCRYPT='$2b$...'
